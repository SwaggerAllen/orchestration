{
  "name": "a queued ticket sharing a system with one in checks dispatches now, where the label mutex made it wait for the merge (DESIGN 6)",
  "steps": [
    {"kind": "seed", "key": "T1", "state": "ready_for_rework", "labels": ["system:delivery"]},
    {"kind": "seed", "key": "T2", "state": "ready_for_rework", "labels": ["system:delivery"]},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T1", "runKind": "dev", "runLive": true},
    {"kind": "expect", "key": "T2", "state": "ready_for_rework", "runLive": false},

    {"kind": "transition", "key": "T1", "to": "reworking", "actor": "dev"},
    {"kind": "transition", "key": "T1", "to": "checks", "actor": "dev"},
    {"kind": "run-end", "key": "T1"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T2", "runKind": "dev", "runLive": true},

    {"kind": "ci", "key": "T1", "status": "green", "run": "https://ci/1"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T1", "state": "reconciling"}
  ]
}
