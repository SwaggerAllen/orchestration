{
  "name": "boundary: creation on drain, live suite, pause, blocker drain, author signal, resume (DESIGN 10)",
  "steps": [
    {"kind": "milestone", "name": "M1"},
    {"kind": "seed", "key": "T1", "state": "done", "milestone": "M1"},
    {"kind": "sweep"},
    {"kind": "expect-boundary", "milestone": "M1"},
    {"kind": "expect", "key": "B-M1", "state": "todo", "runKind": "live-suite", "runLive": true},

    {"kind": "run-end", "key": "B-M1"},
    {"kind": "comment", "key": "B-M1", "marker": "live-suite", "fields": {"result": "pass", "run": "https://ci/live/1"}, "actor": "controlplane"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "B-M1", "state": "todo", "runLive": false, "markers": {"live-suite": 1}},

    {"kind": "seed", "key": "T2", "state": "ready_for_dev", "milestone": "M2", "createdAgo": "2h"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T2", "state": "ready_for_dev", "runLive": false},

    {"kind": "seed", "key": "T3", "state": "ready_for_dev", "milestone": "M1", "blocks": ["B-M1"]},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T3", "runKind": "dev", "runLive": true},

    {"kind": "advance", "by": "1m"},
    {"kind": "transition", "key": "B-M1", "to": "in_progress", "actor": "author"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "B-M1", "state": "in_progress", "runLive": false},

    {"kind": "run-end", "key": "T3"},
    {"kind": "transition", "key": "T3", "to": "canceled", "actor": "author"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "B-M1", "runKind": "boundary", "runLive": true},

    {"kind": "transition", "key": "B-M1", "to": "boundary_review", "actor": "boundary"},
    {"kind": "run-end", "key": "B-M1"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "B-M1", "state": "boundary_review"},
    {"kind": "expect", "key": "T2", "runLive": false},

    {"kind": "transition", "key": "B-M1", "to": "done", "actor": "author"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T2", "runKind": "dev", "runLive": true},
    {"kind": "expect-boundary", "milestone": "M1"}
  ]
}
