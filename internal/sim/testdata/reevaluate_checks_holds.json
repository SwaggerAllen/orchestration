{
  "name": "re-evaluate in Checks is evaluated in place: green CI does not promote until cleared (DESIGN 7)",
  "steps": [
    {"kind": "seed", "key": "T1", "state": "checks", "labels": ["re-evaluate"]},
    {"kind": "ci", "key": "T1", "status": "green", "run": "https://ci/1"},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T1", "state": "checks", "runLive": false},
    {"kind": "label", "key": "T1", "remove": ["re-evaluate"]},
    {"kind": "sweep"},
    {"kind": "expect", "key": "T1", "state": "reconciling", "runKind": "reconcile", "runLive": true}
  ]
}
